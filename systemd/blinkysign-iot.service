[Unit]
Description=BlinkySign AWS IoT Core Client
After=network-online.target blinkysign.service
Wants=network-online.target
Requires=blinkysign.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/venv/bin/python __INSTALL_DIR__/iot_client.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
