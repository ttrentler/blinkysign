[Unit]
Description=BlinkySign Physical Button Handler
After=blinkysign.service
Requires=blinkysign.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/venv/bin/python __INSTALL_DIR__/physical_button.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
